{
  "name": "pulsate",
  "version": "0.0.1",
  "description": "Easy-to-change, faster, developer friendly next generation decentralized social media.",
  "type": "module",
  "main": "main.ts",
  "license": "Apache-2.0",
  "keywords": [],
  "packageManager": "pnpm@11.21.0",
  "author": {
    "name": "pulsate-dev",
    "email": "info@pulsate.dev"
  },
  "engines": {
    "node": "26.7.0"
  },
  "scripts": {
    "start": "node --env-file=.env --enable-source-maps main.ts",
    "build:api": "node scripts/apidoc.ts",
    "build:prisma": "prisma generate",
    "clean": "rm -r ./build",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:type": "tsc -p .",
    "check:filename": "ls-lint",
    "check:format": "biome format .",
    "prepare": "pnpm run build:prisma",
    "postinstall": "lefthook install"
  },
  "dependencies": {
    "@hono/node-server": "2.0.12",
    "@hono/swagger-ui": "0.6.1",
    "@hono/zod-openapi": "1.5.3",
    "@mikuroxina/mini-fn": "7.4.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@scalar/hono-api-reference": "0.11.16",
    "@upyo/core": "0.5.3",
    "@upyo/smtp": "0.5.3",
    "argon2": "0.45.1",
    "blurhash": "2.0.5",
    "file-type": "22.0.2",
    "hono": "4.12.34",
    "ioredis": "5.11.1",
    "jose": "6.2.10",
    "pg": "8.22.0",
    "prisma": "7.9.1",
    "sharp": "0.35.3",
    "tslog": "4.11.0",
    "valibot": "1.4.2",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@ls-lint/ls-lint": "^2.2.3",
    "@types/node": "^26.0.0",
    "@types/pacote": "^11.1.8",
    "@types/pg": "^8.15.6",
    "@vitest/coverage-v8": "^4.0.0",
    "lefthook": "^2.0.0",
    "pacote": "^22.0.0",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  }
}
